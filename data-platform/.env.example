# ==================================================================
# Configuration de la plateforme DataLakeHouse
#
#   cp .env.example .env      puis adapter les valeurs
#
# Ce fichier sert à deux choses :
#   - docker compose le lit automatiquement au démarrage ;
#   - les scripts (setup_lakehouse.sh, reset_bronze.sh) l'utilisent
#     une fois chargé dans le shell avec :
#       set -a; eval "$(sed 's/\r$//' .env)"; set +a
#
# Développement local uniquement : change TOUS les mots de passe
# avant de déployer sur un serveur (VPS).
# Pas d'espaces autour de "=", pas de guillemets nécessaires.
# ==================================================================

# ------------------------------------------------------------------
# Stockage objet RustFS (compatible S3)
# Utilisé par RustFS, Polaris, Trino et les scripts.
# ------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123

# ------------------------------------------------------------------
# PostgreSQL (bases airflow, polaris, metabase, openmetadata_db)
# Utilisé par Postgres et tous les services qui s'y connectent (défaut : admin).
# ⚠️ Pris en compte uniquement à la création du volume postgres_data.
# Pour le changer ensuite : docker compose down -v (efface les données).
# ------------------------------------------------------------------
AIRFLOW_DB_PASSWORD=airflow_local_password

# ------------------------------------------------------------------
# Compte administrateur de l'interface Airflow (http://localhost:8081)
# ------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Linux / VPS uniquement : UID de ton compte (résultat de "id -u"), pour
# que les fichiers écrits par Airflow dans les dossiers montés t'appartiennent.
# Inutile sur macOS.
# AIRFLOW_UID=1000

# ------------------------------------------------------------------
# Services optionnels (profils docker compose)
#   bi          -> Metabase              http://localhost:3000
#   gouvernance -> OpenMetadata          http://localhost:8585
# Décommente pour les activer à chaque "docker compose up".
# ------------------------------------------------------------------
# COMPOSE_PROFILES=bi,gouvernance

# Compte administrateur Metabase (créé au premier démarrage).
# Metabase refuse les mots de passe trop simples.
METABASE_ADMIN_EMAIL=admin@datalakehouse.local
METABASE_ADMIN_PASSWORD=Lakehouse2026!

# Mot de passe de admin@open-metadata.org, utilisé par l'ingestion.
# À mettre à jour si tu le changes dans l'interface d'OpenMetadata.
OPENMETADATA_ADMIN_PASSWORD=admin

# Mémoire Java (à réduire si Docker manque de RAM)
# OPENMETADATA_HEAP_OPTS=-Xmx1G -Xms1G
# ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------------
# Optionnel : paramètres des scripts (les valeurs par défaut suffisent)
# Décommente une ligne pour la modifier.
# ------------------------------------------------------------------
# Fichier du catalogue Trino modifié par setup_lakehouse.sh
# (par défaut : trino/catalog/iceberg.properties, à côté du script)
# TRINO_PROPS=./trino/catalog/iceberg.properties

# Catalogue Polaris et bucket RustFS utilisés par les scripts
# CATALOG=lakehouse
# BUCKET=lakehouse

# Identifiants Polaris. ⚠️ Ils doivent correspondre à ceux écrits en dur
# dans docker-compose.yml (polaris-bootstrap) et dans
# trino/catalog/iceberg.properties.
# CLIENT_ID=root
# CLIENT_SECRET=s3cr3t

# Conteneur Trino ciblé par les scripts
# TRINO_CONTAINER=dlh-trino

# Connexion Trino utilisée par ingest_bronze.py
# TRINO_HOST=localhost
# TRINO_PORT=8080
# TRINO_USER=ingest
# TRINO_CATALOG=iceberg
# TRINO_SCHEMA=bronze
# BRONZE_TABLE=frequentation_sncf_v2
